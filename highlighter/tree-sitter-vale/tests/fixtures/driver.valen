// Era 2, rung 2 — the full windowed driver, the Valen twin of crates/nobiliav/rust/src/bin/driver.rs.
//
// The library owns the loop (winit run_app, on the main thread — the shape macOS requires to
// composite). Valen supplies the per-frame logic as a callback: it opens the NobiliaV window, loads
// the level from its .level.toml, scatters glass dominoes, and hands main_loop a MainLoopCallback. The
// library calls on_tick each frame with the window and this frame's input; on_tick orbits the camera on
// the arrow keys and identifies a tile on a click. The loop ends when the window closes or Esc is pressed.
//
// The level is loaded from a .level.toml through the shared loader (w.load_level), not hand-built:
// the reference map (crates/geometry/tests/fixtures/reference.level.toml) by default, or the
// NOBILIAV_LEVEL file if set. The path is read Rust-side — no string crosses the interop (&str declines).
//
// Everything crosses the interop as primitives, opaque structs, or shared borrows — no field access,
// no struct literals, no float, no enum casts, no by-value structs inbound — so the facade exposes
// new()/accessors/key-constants, and the callback takes the window and input by reference.
//
// Run it interactively (a window opens; arrows orbit, click identifies a tile, Esc/close quits),
// through exp-4's permanent pipeline (valen build reads Valen.toml, whose [rust-dependencies] names
// the fork-built nobiliav crate; the exact recipe is paired with exp-4 for our multi-crate graph).

import rust.nobiliav.NobiliaWindow;
import rust.nobiliav.FrameInput;
import rust.nobiliav.MainLoopCallback;
// Uncomment together with the borrow-check probe in on_tick below.
// import rust.nobiliav.Dimensions;
import rust.nobiliav.key_arrow_left;
import rust.nobiliav.key_arrow_right;
import rust.nobiliav.key_arrow_up;
import rust.nobiliav.key_arrow_down;
import rust.nobiliav.key_r;

// The per-frame logic is a closure handed straight to the imported rust trait MainLoopCallback via the
// trait's own name as a constructor — `MainLoopCallback((win, input) => {...})` at the main_loop call
// below — for which exp-4 auto-generates the forwarder substruct + impl + on_tick. No hand-written
// forwarder (the old `struct TickForwarder<F>` / `MyMainLoopCallback` is retired to git history).
//
// This works for our churning trait — on_tick's signature is `&mut self, &mut NobiliaWindow` — because
// exp-4's trait-name-as-constructor now supports &mut-signature traits (it once gated them out; the gap
// and its A/B are captured at docs/repros/valen-trait-name-ctor-mut-self/).
//
// REQUIRES `valen build --no-borrow-check`. The closure body churns the window (rotate_camera is
// &mut self); the &mut representation + stub rendering are what's built, but churn ENFORCEMENT is a
// separate deferred exp-4 feature (docs/repros/valen-generic-forwarder-churn/), so the check stays off.

exported func main() int {
  w = NobiliaWindow.new(1200, 900);

  // Load the level from its `.level.toml` (crates/geometry/tests/fixtures/reference.level.toml by
  // default, or the NOBILIAV_LEVEL file if set) through the shared loader — replaces the retired
  // hand-built push_run sequence. No path crosses the interop: the file is read Rust-side.
  w.load_level();

  // Float spinning glass dominoes over half the ocean tiles (they spin on their own). This is the
  // expansion of the old `w.add_dominoes_on_ocean()` scatter, one create_domino per picked cell —
  // exactly the water-topped tiles whose deterministic scatter hash selects them.
  w.create_domino(-2, -2, 0);
  w.create_domino(-2, -2, 2);
  w.create_domino(-2, -2, 4);
  w.create_domino(-2, -2, 6);
  w.create_domino(-1, -2, 1);
  w.create_domino(-1, -2, 3);
  w.create_domino(-1, -2, 5);
  w.create_domino(-1, -1, 0);
  w.create_domino(-1, -1, 2);
  w.create_domino(-1, -1, 4);
  w.create_domino(0, -2, 2);
  w.create_domino(0, -2, 4);
  w.create_domino(0, -2, 6);
  w.create_domino(0, -1, 1);
  w.create_domino(0, -1, 3);
  w.create_domino(0, -1, 5);
  w.create_domino(0, 0, 0);
  w.create_domino(0, 0, 2);
  w.create_domino(0, 0, 4);
  w.create_domino(1, -2, 5);
  w.create_domino(1, -2, 7);
  w.create_domino(1, -1, 0);
  w.create_domino(1, -1, 2);
  w.create_domino(1, -1, 4);
  w.create_domino(1, -1, 6);
  w.create_domino(1, 0, 1);
  w.create_domino(1, 0, 3);
  w.create_domino(1, 1, 0);
  w.create_domino(2, -1, 1);
  w.create_domino(2, -1, 3);
  w.create_domino(2, -1, 5);
  w.create_domino(2, -1, 7);
  w.create_domino(3, -1, 4);
  w.create_domino(3, -1, 6);
  w.create_domino(3, 0, 1);
  w.create_domino(4, 0, 4);
  w.create_domino(4, 0, 6);
  w.fit_camera(37, 42);

  // The library owns the loop from here, calling on_tick each frame until the window closes or Esc.
  // Per-frame logic is a closure handed straight to the trait via its name-as-constructor: orbit on
  // arrows, pick on click. The compiler auto-generates the forwarder from this MainLoopCallback(lambda).
  cb = MainLoopCallback((win, input) => {
    key = input.key();
    if (key == key_arrow_left()) {
      win.rotate_camera(-4, 0);
    } else if (key == key_arrow_right()) {
      win.rotate_camera(4, 0);
    } else if (key == key_arrow_up()) {
      win.rotate_camera(0, 4);
    } else if (key == key_arrow_down()) {
      win.rotate_camera(0, -4);
    } else if (key == key_r()) {
      // Reload the level from its .level.toml file on disk (reference.level.toml, or NOBILIAV_LEVEL) —
      // re-reads it live so edits to the file show up, like the editor's R key.
      win.load_level();
    }

    if (input.mouse_x() != -1) {
      win.report_pick(input.mouse_x(), input.mouse_y());
    }
  });
  w.main_loop(&cb);
  return 0;
}
