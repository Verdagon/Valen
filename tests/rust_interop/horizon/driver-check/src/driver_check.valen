// The bounded twin of NobiliaV's driver: the same frame-loop callback, plus a frame cap so it exits on
// its own (no human closing the window). It is the automated proof that the whole inverted loop compiles
// and runs end to end through the interop — the callback dispatch, the by-reference input, the outbound
// calls on the window — returning 7 after 30 frames.

import nobiliav.NobiliaWindow;
import nobiliav.FrameInput;
import nobiliav.MainLoopCallback;
import nobiliav.key_arrow_left;
import nobiliav.key_arrow_right;
import nobiliav.key_arrow_up;
import nobiliav.key_arrow_down;

exported func main() int {
  w = NobiliaWindow.new(1200, 900);

  w.load_terrain();
  w.fit_camera(37, 42);

  // The whole point of the endeavor: hand the frame-loop callback as a lambda directly to the imported
  // `MainLoopCallback` trait, with NO hand-written forwarder struct/impl/override. The compiler runs the
  // anonymous-substruct macro on the imported trait and projects the synthesized substruct all the way
  // to Rust codegen, so `w.main_loop(&cb)` dispatches into this lambda every frame.
  cb = MainLoopCallback((win, inp) => {
    key = inp.key();
    if (key == key_arrow_left()) {
      win.rotate_camera(-4, 0);
    } else if (key == key_arrow_right()) {
      win.rotate_camera(4, 0);
    } else if (key == key_arrow_up()) {
      win.rotate_camera(0, 4);
    } else if (key == key_arrow_down()) {
      win.rotate_camera(0, -4);
    }

    if (inp.mouse_x() != -1) {
      win.report_pick(inp.mouse_x(), inp.mouse_y());
    }

    // The one line driver.vale lacks: end the run after 30 frames instead of waiting for a human.
    if (win.frame_index() >= 30) {
      win.request_exit();
    }
  });
  w.main_loop(&cb);
  return 7;
}
