sealed exported classinterface IShip { }
abstract func getFuel(virtual ship &IShip) int;

exported class Firefly { fuel int; }
impl IShip for Firefly;
func getFuel(ship Firefly) int { ship.fuel }

extern func cGetShipFuel(s IShip) int;

exported func main() int {
  x IShip = Firefly(7); // force the impl to be emitted
  return cGetShipFuel(Firefly(42));
}
