sealed exported classinterface IShape { }

exported class Circle { radius int; }
impl IShape for Circle;

exported class Square { side int; }
impl IShape for Square;

exported class Triangle { base int; height int; }
impl IShape for Triangle;

extern func computeArea(s IShape) int;

exported func main() int {
  x IShape = Circle(1);
  y IShape = Square(1);
  z IShape = Triangle(1, 1);
  return computeArea(Triangle(6, 14));
}
