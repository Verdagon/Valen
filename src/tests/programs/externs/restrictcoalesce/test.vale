extern func noopBarrier();

exported struct Ship { fuel int; }

exported func do_things<g'>(a &Ship in g, b &Ship in g) int {
  q = __copy_prim(b.fuel);
  x = __copy_prim(a.fuel);
  noopBarrier();
  y = __copy_prim(a.fuel);
  return q + x + y;
}

exported func main() int {
  s1 = Ship(1);
  s2 = Ship(2);
  return do_things(&s1, &s2);
}
