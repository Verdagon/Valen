import v.builtins.implicit_clone.*;
import v.builtins.arith.*;
import v.builtins.drop.*;
import v.builtins.panic.*;

struct DropFunctor<T> { }
func __call<T, g'>(self &DropFunctor<T> in g, elem T)
where func drop(T)void {
  ^elem;
}

extern("vale_static_sized_array_len")
func len<S Int, E, g'>(arr &StaticArray<S, E> in g) int;

extern("vale_runtime_sized_array_new")
func Array<E>(size int) []E;

extern("vale_runtime_sized_array_push")
func push<E, g'>(arr &[]E in g, newElement E) void;

extern("vale_runtime_sized_array_pop")
func pop<E, g'>(arr &[]E in g) E;

extern("vale_runtime_sized_array_len")
func len<E, g'>(arr &[]E in g) int;

extern("vale_runtime_sized_array_capacity")
func capacity<E, g'>(arr &[]E in g) int;

func drop_into<E, F, g'>(arr []E, consumer &F in g) void
where func(&F, E)void
{
  while ((&arr).len() > 0) {
    consumer((&arr).pop());
  }
  [] = ^arr;
}

func drop<E>(arr []E) void
where func drop(E)void {
  drop_into(^arr, &DropFunctor<E>());
}

extern("vale_static_sized_array_drop_into")
func drop_into<S Int, E, F, g'>(arr StaticArray<S, E>, consumer &F in g) void
where func(&F, E)void;

func drop<S Int, E>(arr StaticArray<S, E>) void
where func drop(E)void {
  drop_into(^arr, &DropFunctor<E>());
}

func Array<E, G, g'>(n int, generator &G in g) []E
where
  func(&G, int)E,
  func drop(G)void
{
  // TSUGAR:   arr = Array<E>(n);
  arr = Array<E>(__copy_prim(&n));
  i = 0;
  while (i < n) {
    // TSUGAR:     arr.push(generator(i));
    (&arr).push(generator(__copy_prim(&i)));
    set i = i + 1;
  }
  return ^arr;
}
