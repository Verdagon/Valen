import v.builtins.implicit_clone.*;

func +<ga', gb'>(a &str in ga, b &str in gb) str { return __vbi_addStr(a, 0, len(a), b, 0, len(b)); }
extern func __vbi_addStr<ga', gb'>(a &str in ga, aBegin int, aEnd int, b &str in gb, bBegin int, bEnd int) str;

func str(x int) str { return __vbi_castI32Str(x); }
extern func __vbi_castI32Str(x int) str;

func str(x i64) str { return __vbi_castI64Str(x); }
extern func __vbi_castI64Str(x i64) str;

func str(x float) str { return __vbi_castFloatStr(x); }
extern func __vbi_castFloatStr(x float) str;

func len<g'>(s &str in g) int { return __vbi_strLength(s); }
extern func __vbi_strLength<g'>(s &str in g) int;

func strtoascii<g'>(s &str in g, begin int, end int) int {
  return __vbi_strtoascii(s, begin, end);
}
extern func __vbi_strtoascii<g'>(s &str in g, begin int, end int) int;

func strfromascii(code int) str { return __vbi_strfromascii(code); }
extern func __vbi_strfromascii(code int) str;

func strindexof<gh', gn'>(
  haystackContainer &str in gh,
  haystackBegin int,
  haystackEnd int,
  needleContainer &str in gn,
  needleBegin int,
  needleEnd int)
int {
  return __vbi_strindexof(haystackContainer, haystackBegin, haystackEnd,
                          needleContainer, needleBegin, needleEnd);
}
extern func __vbi_strindexof<gh', gn'>(
  haystackContainer &str in gh,
  haystackBegin int,
  haystackEnd int,
  needleContainer &str in gn,
  needleBegin int,
  needleEnd int)
int;

func substring<gh'>(
  haystackContainer &str in gh,
  begin int,
  end int)
str {
  return __vbi_substring(haystackContainer, begin, end);
}
extern func __vbi_substring<gh'>(
  haystackContainer &str in gh,
  begin int,
  end int)
str;

func strcmp<ga', gb'>(
  aContainerStr &str in ga,
  aBegin int,
  aEnd int,
  bContainerStr &str in gb,
  bBegin int,
  bEnd int)
int {
  return __vbi_strcmp(aContainerStr, aBegin, aEnd, bContainerStr, bBegin, bEnd);
}
extern func __vbi_strcmp<ga', gb'>(
  aContainerStr &str in ga,
  aBegin int,
  aEnd int,
  bContainerStr &str in gb,
  bBegin int,
  bEnd int)
int;
