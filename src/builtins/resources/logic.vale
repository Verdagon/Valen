import v.builtins.implicit_clone.*;

func not(b bool) bool { return __vbi_not(b); }
func not<g'>(b &bool in g) bool { return __vbi_not(__copy_prim(b)); }
extern func __vbi_not(b bool) bool;

func ==(left bool, right bool) bool { return __vbi_eqBoolBool(left, right); }
func ==<gl', gr'>(left &bool in gl, right &bool in gr) bool { return __vbi_eqBoolBool(__copy_prim(left), __copy_prim(right)); }
extern func __vbi_eqBoolBool(left bool, right bool) bool;

func !=<T, ga', gb'>(a &T in ga, b &T in gb) bool
where func ==(&T, &T)bool {
  not (a == b)
}
